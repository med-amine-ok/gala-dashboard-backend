# Copy to gala_event/gala_event/.env for local development.
# On Render set these as environment variables (real env vars win over the file).
# NEVER point a local .env at the production database.

# --- Required ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string     # the app refuses to start without it
DATABASE_URL=sqlite:///db.sqlite3                # production: the Neon Postgres URL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Security / hosting -----------------------------------------------------
DEBUG=False                                      # True only on your own machine
ALLOWED_HOSTS=gala-dashboard-backend.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://gala-dashboard-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://gala.vic-enp.com,https://gala-vic.vercel.app,http://localhost:3000
# SECURE_SSL_REDIRECT=True                       # default True when DEBUG=False
# SECURE_HSTS_SECONDS=2592000
# NUM_PROXIES=1                                  # Render's proxy, used for rate limiting by IP
# API_DOCS_PUBLIC=False                          # Swagger/ReDoc only for staff unless True

# --- Email (approval, payment link, activation code, payment confirmation) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
LANDING_URL=https://gala.vic-enp.com             # payment links point here
PAYMENT_LINK_IN_APPROVAL_EMAIL=True

# --- Optional tuning --------------------------------------------------------
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=30
# ACTIVATION_CODE_TTL_MINUTES=15
# ACTIVATION_CODE_MAX_ATTEMPTS=5
# THROTTLE_LOGIN=30/min
# THROTTLE_REGISTER=120/hour
# THROTTLE_SET_PASSWORD=60/hour
# THROTTLE_FEEDBACK=20/hour
# THROTTLE_TICKET_VERIFY=30/min
# CACHE_URL=redis://...                          # only if you add Redis; default is in-memory
# LOG_LEVEL=INFO
